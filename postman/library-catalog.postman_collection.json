{
  "info": {
    "_postman_id": "e3ef9a13-c812-4d3f-90c7-e4d73a4c2c71",
    "name": "Library Catalog API",
    "description": "CRUD, search, filtering, pagination, and validation examples for the Library Book Catalog API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "genreId", "value": "REPLACE_WITH_GENRE_OBJECT_ID" },
    { "key": "bookId", "value": "REPLACE_WITH_BOOK_OBJECT_ID" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "GET health", "request": { "method": "GET", "url": "{{baseUrl}}/health" }, "response": [] }
      ]
    },
    {
      "name": "Genres",
      "item": [
        { "name": "GET all genres", "request": { "method": "GET", "url": "{{baseUrl}}/genres" }, "response": [] },
        { "name": "GET genre by ID", "request": { "method": "GET", "url": "{{baseUrl}}/genres/{{genreId}}" }, "response": [] },
        { "name": "POST create genre", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Test Genre\",\n  \"slug\": \"postman-test-genre\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/genres" }, "response": [] },
        { "name": "PUT update genre", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Postman Genre\",\n  \"slug\": \"updated-postman-genre\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/genres/{{genreId}}" }, "response": [] },
        { "name": "DELETE genre (only if no books reference it)", "request": { "method": "DELETE", "url": "{{baseUrl}}/genres/{{genreId}}" }, "response": [] }
      ]
    },
    {
      "name": "Books",
      "item": [
        { "name": "GET books (all filters combined)", "request": { "method": "GET", "url": "{{baseUrl}}/books?genre={{genreId}}&search=dune&page=1&limit=5" }, "response": [] },
        { "name": "GET book by ID", "request": { "method": "GET", "url": "{{baseUrl}}/books/{{bookId}}" }, "response": [] },
        { "name": "POST create book", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Postman Dune Edition\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"9781234598765\",\n  \"description\": \"A sample book created from Postman.\",\n  \"coverImage\": \"https://example.com/postman-dune.jpg\",\n  \"totalCopies\": 6,\n  \"availableCopies\": 4,\n  \"genre\": \"{{genreId}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/books" }, "response": [] },
        { "name": "POST invalid book (saved 400 example)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/books" }, "response": [{ "name": "400 Validation failed", "originalRequest": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/books" }, "status": "Bad Request", "code": 400, "header": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }], "cookie": [], "body": "{\n  \"error\": \"Validation failed\",\n  \"fields\": [\n    {\n      \"field\": \"title\",\n      \"message\": \"is required\"\n    },\n    {\n      \"field\": \"author\",\n      \"message\": \"is required\"\n    },\n    {\n      \"field\": \"isbn\",\n      \"message\": \"is required\"\n    },\n    {\n      \"field\": \"description\",\n      \"message\": \"is required\"\n    },\n    {\n      \"field\": \"coverImage\",\n      \"message\": \"is required\"\n    },\n    {\n      \"field\": \"totalCopies\",\n      \"message\": \"is required\"\n    },\n    {\n      \"field\": \"availableCopies\",\n      \"message\": \"is required\"\n    },\n    {\n      \"field\": \"genre\",\n      \"message\": \"is required\"\n    }\n  ]\n}" }] },
        { "name": "PUT update book", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated Postman Dune Edition\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"9781234598766\",\n  \"description\": \"Updated sample book.\",\n  \"coverImage\": \"https://example.com/postman-dune-updated.jpg\",\n  \"totalCopies\": 7,\n  \"availableCopies\": 5,\n  \"genre\": \"{{genreId}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/books/{{bookId}}" }, "response": [] },
        { "name": "DELETE book", "request": { "method": "DELETE", "url": "{{baseUrl}}/books/{{bookId}}" }, "response": [] }
      ]
    }
  ]
}